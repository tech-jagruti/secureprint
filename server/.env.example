PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (leave blank to use local disk storage for quick demos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Change both of these. Use long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
CODE_SECRET=change-me-too

CODE_LENGTH=4
MAX_ATTEMPTS=5
MAX_FILE_MB=10
